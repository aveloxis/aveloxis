{
  "Cargo.toml": [
    {
      "name": "anyhow",
      "version": "1.0.86",
      "requirement": "anyhow = \"1.0.86\"",
      "type": "runtime",
      "manager": "cargo"
    },
    {
      "name": "criterion",
      "version": "0.5",
      "requirement": "criterion = \"0.5\"",
      "type": "dev",
      "manager": "cargo"
    },
    {
      "name": "fork",
      "version": "",
      "requirement": "fork = { git = \"https://github.com/x/y\" }",
      "type": "runtime",
      "manager": "cargo"
    },
    {
      "name": "local",
      "version": "",
      "requirement": "local = { path = \"../..\" }",
      "type": "runtime",
      "manager": "cargo"
    },
    {
      "name": "serde",
      "version": "",
      "requirement": "serde = { workspace = true }",
      "type": "runtime",
      "manager": "cargo"
    },
    {
      "name": "tokio",
      "version": "1.38",
      "requirement": "tokio = { version = \"1.38\", features = [\"full\"] }",
      "type": "runtime",
      "manager": "cargo"
    },
    {
      "name": "wild",
      "version": "",
      "requirement": "wild = \"*\"",
      "type": "runtime",
      "manager": "cargo"
    }
  ],
  "Gemfile": [
